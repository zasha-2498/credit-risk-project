CREATE OR REPLACE VIEW `credit_risk.model_ready_credit_risk` AS
SELECT
  person_age,
  person_income,
  person_home_ownership,
  person_emp_length,
  loan_intent,
  loan_grade,
  loan_amnt,
  loan_int_rate,
  loan_status AS default_flag,
  loan_percent_income,
  cb_person_default_on_file,
  cb_person_cred_hist_length
FROM `credit_risk.raw_credit_risk`;
